{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile for Helpify student workspace",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 100 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Task": {
      "title": "Task",
      "description": "Student academic deadline or assignment task",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "dueDate": { "type": "string", "maxLength": 20 },
        "priority": { "type": "string", "enum": ["high", "medium", "low"] },
        "category": { "type": "string", "enum": ["assignment", "exam", "reading", "project", "lab"] },
        "course": { "type": "string", "maxLength": 100 },
        "completed": { "type": "boolean" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "dueDate", "priority", "category", "completed", "userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Public profile document for authenticated student"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": "Task",
      "description": "Student personal academic tasks and deadlines"
    }
  }
}
